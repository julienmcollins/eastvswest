# ---- Copy to `.env` and fill in. Never commit `.env`. ----

# ---- Server ----
PORT=3000
NODE_ENV=development

# Public base URL of the whole app while it is single-origin (local dev).
# API_BASE_URL and WEB_ORIGIN both default to this, so locally you only set this one.
APP_BASE_URL=http://localhost:3000

# Origin serving the /api/* routes. Builds the OAuth `redirect_uri`, so its domain must
# match the Authorization Callback Domain in your Strava API application settings
# (Strava matches on domain, not full path).
# At deploy time this becomes e.g. https://api.example.com.
API_BASE_URL=

# Origin serving the static frontend. Post-OAuth redirect target and the sole CORS
# allowlist entry. At deploy time this becomes e.g. https://www.example.com.
# Keep this on the SAME registrable domain as API_BASE_URL, or the session cookie
# becomes third-party and Safari blocks it outright. See docs/SPEC.md.
WEB_ORIGIN=

# Sub-path the frontend is served under, if it is not at a domain root. Empty for a custom
# domain; `/<repo>` for a GitHub Pages PROJECT site, which serves public/ from
# `user.github.io/<repo>/`. It CANNOT go in WEB_ORIGIN: an Origin header is scheme + host +
# port with no path, so a path there matches no real browser Origin and silently empties the
# CORS allowlist -- every mutating request then 403s on the Origin check. The post-OAuth
# redirect and safeReturnTo are the only readers.
WEB_BASE_PATH=

# Hand the new session token to the frontend in the callback's URL fragment (#token=)
# instead of relying on the bc_sid cookie. Leave false unless the frontend and the API are
# on DIFFERENT registrable domains -- the default-host deploy
# (user.github.io + <worker>.<account>.workers.dev) is the case that forces it, because
# there both bc_sid and bc_csrf are third-party cookies the browser never returns.
# An HttpOnly cookie is strictly safer, so this is opt-in, and turning it on requires
# SESSION_TTL_SECONDS <= 86400 (the token lives in localStorage). See docs/DEPLOY.md.
AUTH_TOKEN_IN_FRAGMENT=false

# SQLite database file. Created on first run.
DATABASE_PATH=./data/bike-comp.db

# ---- Strava API application (https://www.strava.com/settings/api) ----
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Overridable so the test suite can point at an in-process fake Strava.
# Both INCLUDE the path prefix, so swapping them is a pure origin swap.
STRAVA_API_BASE=https://www.strava.com/api/v3
STRAVA_OAUTH_BASE=https://www.strava.com/oauth

# DEAD SETTING -- kept only so nobody wonders where it went. We deliberately build no
# webhook route: webhooks need a public HTTPS URL we do not have locally, and an
# unauthenticated hub-challenge echo is free attack surface for a feature we skipped.
# Nothing reads this.
STRAVA_WEBHOOK_VERIFY_TOKEN=

# ---- Secrets: generate with `npm run keygen` ----
# HMAC key for signing the OAuth `state`. >=32 bytes, base64.
SESSION_SECRET=
# AES-256-GCM key encrypting Strava tokens at rest. EXACTLY 32 bytes, base64.
TOKEN_ENCRYPTION_KEY=

# ---- Competition window ----
# EVERY CALENDAR MONTH IS ITS OWN COMPETITION. These two no longer bound what the
# leaderboard can show: the month picker offers every month that holds a countable ride,
# plus the current month, plus the range below -- so this is a FLOOR on what is
# selectable, never a ceiling. A ride is attributed to the month of its Strava
# start_date_local calendar date, so each coast is judged against its own local calendar
# day, which is the fair reading for a cross-timezone race.
#
# What these two still decide:
#   1. the Strava FETCH window (the one thing that spends rate limit, deliberately not
#      widened -- rides outside it are never downloaded, so a month outside it is only
#      selectable once something has been fetched into it);
#   2. the DEFAULT month on first paint: the current month, clamped into this range;
#   3. the DEFAULT floor a backfill reaches (`npm run backfill`).
#
# BACKDATE THE START to when the competition really began. A START in the FUTURE is not a
# harmless "not open yet": the fetch floor collapses onto the first of the CURRENT month, so
# earlier months are never downloaded at all, and because the floor's only other widening
# source is the data already stored, no amount of re-syncing can go back for them. Recovering
# them then needs `npm run backfill -- --remote --since <month>` -- see docs/DEPLOY.md step 4.
# See docs/SPEC.md "The month picker".
COMPETITION_START=2026-01-01
COMPETITION_END=2026-09-30

# The ONLY source of "today", which month is current, the selected month's state, and
# days_remaining. Without it those values shift when the host timezone changes (your Mac
# -> a UTC server). Any IANA zone name, or UTC.
COMPETITION_TZ=UTC

# Comma-separated Strava sport_type values that count toward the totals.
# Note these are sport_type values, not the legacy `type` field: EMountainBikeRide
# reports type="Ride" and must NOT count.
ALLOWED_SPORT_TYPES=Ride,GravelRide,MountainBikeRide,VirtualRide

# Count manually-entered rides? A manual distance is free text with no device and no
# upper bound, so counting them by default means whoever notices first wins. When
# false, manual rides are stored and surfaced in an admin approval list instead.
COUNT_MANUAL_ACTIVITIES=false

# ---- Admin bootstrap ----
# Comma-separated Strava *athlete IDs* granted admin on login. Grant-only: removing an
# id here never revokes an existing admin (use `npm run make-admin -- <id> --revoke`).
# Strava's OAuth response carries no email address, so admins cannot be bootstrapped by
# email. Find your athlete ID at strava.com/settings/profile, or run
# `npm run make-admin -- <id>` after your first sign-in.
ADMIN_BOOTSTRAP_ATHLETE_IDS=

# ---- Session tuning ----
# Session lifetime in seconds (default 30 days).
# Must be <= 86400 when AUTH_TOKEN_IN_FRAGMENT=true: that token sits in localStorage where
# any script on the frontend origin can read it, so it has to be short-lived.
SESSION_TTL_SECONDS=2592000
# Minimum seconds between syncs for one athlete.
SYNC_COOLDOWN_SECONDS=60
