{
  "name": "bike-comp",
  "version": "1.0.0",
  "private": true,
  "description": "East vs West Strava mileage leaderboard. Zero runtime dependencies.",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "deploy-setup": "node scripts/deploy-setup.mjs",
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test \"test/**/*.test.js\"",
    "keygen": "node scripts/keygen.mjs",
    "make-admin": "node scripts/make-admin.mjs",
    "reset-db": "node scripts/reset-db.mjs",
    "probe": "node scripts/strava-probe.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.119.0"
  }
}
